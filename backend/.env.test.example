NODE_ENV=test
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
PORT=8080

# Banco DEDICADO para teste: npm test roda migrate + seed antes e
# migrate:undo:all depois (ver pretest/posttest em package.json). Nunca aponte
# para o mesmo banco que você usa em desenvolvimento — o posttest apaga todas
# as tabelas.
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=whaticket
DB_PASS=whaticket
DB_NAME=whaticket_test

JWT_SECRET=test_secret_only_for_automated_tests
JWT_REFRESH_SECRET=test_refresh_secret_only_for_automated_tests

REDIS_URI=redis://127.0.0.1:6379
REDIS_OPT_LIMITER_MAX=1
REDIS_OPT_LIMITER_DURATION=3000

USER_LIMIT=10000
CONNECTIONS_LIMIT=100000
CLOSED_SEND_BY_ME=true
